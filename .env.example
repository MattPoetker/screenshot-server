# Database Configuration
# For PostgreSQL (Docker) - comment out to use SQLite
DATABASE_URL=postgresql://screenshot_user:screenshot_password@postgres:5432/screenshot_db
# For SQLite (local development)
DATABASE_PATH=./database/screenshots.db

# Redis Configuration (for Docker)
REDIS_URL=redis://redis:6379

# Images Storage
IMAGES_DIR=/var/www/screenshots

# Storage Configuration (local or r2)
STORAGE_PROVIDER=local
LOCAL_PUBLIC_URL=https://images.sitelaunch.io/images

# CloudFlare R2 Configuration (only needed if STORAGE_PROVIDER=r2)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=your-bucket-name
R2_REGION=auto
R2_PUBLIC_URL=https://cdn.niceshot.api

# Email Configuration (Postmark)
POSTMARK_SERVER_TOKEN=your-postmark-server-token
EMAIL_FROM=noreply@yourdomain.com

# JWT Secret
JWT_SECRET=your-jwt-secret-here

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
APP_NAME=NiceShot API
NODE_ENV=development
PORT=3000

# PostgreSQL Password (for docker-compose)
POSTGRES_PASSWORD=screenshot_password

# Browser Pool Configuration
MAX_BROWSERS=10
BROWSER_MAX_USES=100
BROWSER_IDLE_TIMEOUT=300000
MEMORY_CHECK_INTERVAL=30000
MAX_MEMORY_MB=2048
FORCE_CLEANUP_INTERVAL=600000

# Queue Configuration
QUEUE_CONCURRENCY=5
QUEUE_REMOVE_COMPLETE=100
QUEUE_REMOVE_FAIL=50
QUEUE_JOB_TIMEOUT=60000
QUEUE_RETRY_ATTEMPTS=3
QUEUE_RETRY_DELAY=5000

# Screenshot Caching
ENABLE_SCREENSHOT_CACHE=true
SCREENSHOT_CACHE_TTL=3600