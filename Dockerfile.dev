# Development Dockerfile with proper user permissions
FROM node:18-alpine

# Install system dependencies for Puppeteer and GraphicsMagick
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    freetype-dev \
    harfbuzz \
    ca-certificates \
    ttf-freefont \
    graphicsmagick

# Set Puppeteer to use installed Chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Create app directory
WORKDIR /app

# Install dependencies first (for better caching)
COPY package*.json ./
RUN npm ci --include=dev

# Copy the rest of the application
COPY . .

# Create directories for uploads and screenshots
RUN mkdir -p /app/public/uploads /app/public/screenshots

# Expose port
EXPOSE 3000

# Set environment
ENV NODE_ENV=development

# Start the development server
CMD ["npm", "run", "dev"]